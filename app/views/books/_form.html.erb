<%= form_with(model: book, class: "book-form") do |form| %>

  <% if book.errors.any? %>
    <div class="form-errors">
      <h3>
        <%= book.errors.count %>件のエラーがあります
      </h3>

      <ul>
        <% book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title, "本のタイトル" %>

    <%= form.text_field :title,
        placeholder: "例：吾輩は猫である",
        class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :body, "本の内容・感想" %>

    <%= form.text_area :body,
        rows: 10,
        placeholder: "本の内容や感想を入力してください",
        class: "form-textarea" %>
  </div>

  <div class="form-submit">
    <%= form.submit(
      book.new_record? ? "本を登録する" : "変更を保存する",
      class: "button button-primary"
    ) %>
  </div>

<% end %>