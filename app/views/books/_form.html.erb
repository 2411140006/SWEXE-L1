<%= form_with model: @book do |f| %>

  <% if @book.errors.any? %>
    <div class="error-message">
      <h2><%= @book.errors.count %>件のエラーがあります</h2>

      <ul>
        <% @book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title, "本のタイトル" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :body, "感想・内容" %>
    <%= f.text_area :body, class: "form-control body-field" %>
  </div>

  <div class="form-actions">
    <% if @book.new_record? %>
      <%= f.submit "本を登録する", class: "btn btn-primary" %>
    <% else %>
      <%= f.submit "本を更新する", class: "btn btn-primary" %>
    <% end %>
  </div>

<% end %>