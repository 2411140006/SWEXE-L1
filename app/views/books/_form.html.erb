<%= form_with model: book do |f| %>
  <% if book.errors.any? %>
    <div class="error-box">
      <h2><%= pluralize(book.errors.count, "件のエラー") %>が発生しました</h2>
      <ul>
        <% book.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>

  <div class="form-group">
    <%= f.label :author, "著者" %>
    <%= f.text_field :author %>
  </div>

  <div class="form-group">
    <%= f.label :published_on, "出版日" %>
    <%= f.date_field :published_on %>
  </div>

  <div class="form-group">
    <%= f.label :description, "紹介文" %>
    <%= f.text_area :description %>
  </div>

  <div class="form-group">
    <%= f.submit %>
  </div>
<% end %>