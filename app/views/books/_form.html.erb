<%= form_with model: @book do |f| %>

  <% if @book.errors.any? %>

    <div class="error-message">

      <h3>
        入力内容を確認してください
      </h3>

      <ul>
        <% @book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>

    </div>

  <% end %>


  <div class="form-group">

    <%= f.label :title, "本のタイトル" %>

    <p class="form-help">
      本のタイトルを入力してください。
    </p>

    <%= f.text_field :title,
                     class: "form-control",
                     placeholder: "例：吾輩は猫である" %>

  </div>


  <div class="form-group">

    <%= f.label :body, "本の内容・感想" %>

    <p class="form-help">
      本の内容や感想などを入力してください。
    </p>

    <%= f.text_area :body,
                    class: "form-control body-field",
                    placeholder: "この本についての内容や感想を入力してください。" %>

  </div>


  <div class="form-actions">

    <% if @book.new_record? %>

      <%= f.submit "本を登録する",
                   class: "submit-button" %>

    <% else %>

      <%= f.submit "変更を保存する",
                   class: "submit-button" %>

    <% end %>

  </div>

<% end %>