<section class="page-header">
  <div class="container">
    <p class="section-label">EDIT BOOK</p>

    <h1>本を編集する</h1>
    <p>
      登録されている本の情報を変更できます。
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="form-container">
      <%= render "form", book: @book %>

      <div class="form-back">
        <%= link_to "本の詳細に戻る",
                    book_path(@book),
                    class: "back-link" %>

        <%= link_to "本一覧を見る",
                    books_path,
                    class: "back-link" %>
      </div>
    </div>
  </div>
</section>