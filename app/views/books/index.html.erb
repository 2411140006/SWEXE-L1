<section class="page-header">
  <div class="container">
    <p class="section-label">BOOKS</p>

    <div class="page-header-content">
      <div>
        <h1>本一覧</h1>
        <p>
          登録されている本を一覧で確認できます。
        </p>
      </div>

      <%= link_to "本を登録する", new_book_path, class: "button button-primary" %>
    </div>
  </div>
</section>

<section class="section books-section">
  <div class="container">
    <div class="list-header">
      <h2>登録されている本</h2>
      <p><%= @books.count %>冊の本が登録されています。</p>
    </div>

    <% if @books.any? %>
      <div class="books-grid">
        <% @books.each do |book| %>
          <article class="book-card">
            <div class="book-card-content">
              <p class="book-label">BOOK</p>

              <h3>
                <%= book.title %>
              </h3>

              <p class="book-description">
                <%= truncate(book.body, length: 100) %>
              </p>
            </div>

            <div class="book-card-footer">
              <%= link_to "詳細を見る", book_path(book), class: "text-link" %>

              <div class="card-actions">
                <%= link_to "編集", edit_book_path(book), class: "small-link" %>

                <%= link_to "削除",
                    book_path(book),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "この本を削除しますか？"
                    },
                    class: "small-link delete-link" %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <h3>まだ本が登録されていません</h3>
        <p>
          最初の本を登録してみましょう。
        </p>

        <%= link_to "本を登録する", new_book_path, class: "button button-primary" %>
      </div>
    <% end %>
  </div>
</section>