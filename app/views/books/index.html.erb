<div class="page-header">
  <h1>本一覧</h1>

  <%= link_to "本を登録する", new_book_path, class: "btn btn-primary" %>
</div>

<% if @books.any? %>
  <div class="books-list">

    <% @books.each do |book| %>
      <article class="book-card">

        <h2>
          <%= link_to book.title, book_path(book) %>
        </h2>

        <p class="book-body">
          <%= truncate(book.body, length: 100) %>
        </p>

        <div class="book-actions">
          <%= link_to "詳細を見る",
                      book_path(book),
                      class: "btn btn-secondary" %>

          <%= link_to "編集する",
                      edit_book_path(book),
                      class: "btn btn-secondary" %>

          <%= link_to "削除する",
                      book_path(book),
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "この本を削除してもよろしいですか？"
                      },
                      class: "btn btn-danger" %>
        </div>

      </article>
    <% end %>

  </div>
<% else %>

  <div class="empty-message">
    <p>まだ本が登録されていません。</p>

    <%= link_to "最初の本を登録する",
                new_book_path,
                class: "btn btn-primary" %>
  </div>

<% end %>