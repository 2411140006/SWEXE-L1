<h1>蔵書一覧</h1>

<div class="actions">
  <%= link_to "＋ 新規登録", new_book_path, class: "btn btn-primary" %>
</div>

<% if @books.empty? %>
  <div class="empty-state">
    まだ本が登録されていません。「新規登録」から追加してみましょう。
  </div>
<% else %>
  <table class="book-table">
    <thead>
      <tr>
        <th>タイトル</th>
        <th>著者</th>
        <th>出版日</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @books.each do |book| %>
        <tr>
          <td><%= link_to book.title, book_path(book) %></td>
          <td><%= book.author %></td>
          <td><%= book.published_on %></td>
          <td class="actions-cell">
            <%= link_to "編集", edit_book_path(book), class: "btn btn-edit" %>
            <%= link_to "削除", book_path(book), class: "btn btn-delete",
                  data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>