<section class="page-header">
  <div class="container">
    <p class="section-label">NEW BOOK</p>

    <h1>本を登録する</h1>
    <p>
      本のタイトルと内容を入力して登録してください。
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="form-container">
      <%= render "form", book: @book %>

      <div class="form-back">
        <%= link_to "本一覧に戻る", books_path, class: "back-link" %>
      </div>
    </div>
  </div>
</section>