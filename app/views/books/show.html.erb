<h1><%= @book.title %></h1>

<p><strong>著者：</strong><%= @book.author %></p>
<p><strong>出版日：</strong><%= @book.published_on %></p>
<p><strong>紹介文：</strong><br><%= simple_format(@book.description.presence || "（紹介文はありません）") %></p>

<p>
  <%= link_to "編集", edit_book_path(@book) %> |
  <%= link_to "削除", book_path(@book),
        data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
</p>

<%= link_to "一覧に戻る", books_path %>