<section class="page-header">
  <div class="container">
    <p class="section-label">BOOK DETAIL</p>

    <h1>本の詳細</h1>
    <p>登録されている本の詳細を確認できます。</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <article class="book-detail">
      <div class="detail-header">
        <p class="book-label">BOOK</p>
        <h2><%= @book.title %></h2>
      </div>

      <div class="detail-body">
        <h3>本の内容・感想</h3>

        <p>
          <%= simple_format(@book.body) %>
        </p>
      </div>

      <div class="detail-actions">
        <%= link_to "本を編集する",
                    edit_book_path(@book),
                    class: "button button-primary" %>

        <%= link_to "本一覧に戻る",
                    books_path,
                    class: "button button-outline" %>

        <%= link_to "この本を削除する",
                    book_path(@book),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "この本を削除しますか？"
                    },
                    class: "delete-text-link" %>
      </div>
    </article>
  </div>
</section>