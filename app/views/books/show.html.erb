<div class="page-header">
  <h1>本の詳細</h1>
</div>

<div class="book-detail">

  <div class="detail-item">
    <h2>本のタイトル</h2>
    <p><%= @book.title %></p>
  </div>

  <div class="detail-item">
    <h2>感想・内容</h2>
    <p class="detail-body">
      <%= simple_format(@book.body) %>
    </p>
  </div>

</div>

<div class="page-links">
  <%= link_to "編集する",
              edit_book_path(@book),
              class: "btn btn-primary" %>

  <%= link_to "本一覧に戻る",
              books_path,
              class: "btn btn-secondary" %>

  <%= link_to "削除する",
              book_path(@book),
              data: {
                turbo_method: :delete,
                turbo_confirm: "この本を削除してもよろしいですか？"
              },
              class: "btn btn-danger" %>
</div>