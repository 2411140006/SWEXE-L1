<% if notice %>
  <p style="color: green;"><%= notice %></p>
<% end %>

<h1><%= @book.title %></h1>

<p><strong>著者：</strong><%= @book.author %></p>
<p><strong>出版日：</strong><%= @book.published_on %></p>
<p><strong>紹介文：</strong><br><%= simple_format(@book.description) %></p>

<%= link_to "編集", edit_book_path(@book) %> |
<%= link_to "一覧に戻る", books_path %>