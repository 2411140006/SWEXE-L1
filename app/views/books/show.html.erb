<div class="page-heading">

  <div>
    <p class="page-category">BOOK DETAIL</p>

    <h1>本の詳細</h1>

    <p class="page-description">
      登録されている本の情報を確認できます。
    </p>
  </div>

</div>


<div class="book-detail-card">

  <div class="detail-content">

    <div class="detail-section">

      <p class="detail-label">
        本のタイトル
      </p>

      <h2>
        <%= @book.title %>
      </h2>

    </div>


    <div class="detail-section">

      <p class="detail-label">
        本の内容・感想
      </p>

      <div class="detail-body">
        <%= simple_format(@book.body) %>
      </div>

    </div>

  </div>

</div>


<div class="detail-actions">

  <%= link_to "本を編集する",
              edit_book_path(@book),
              class: "primary-button" %>

  <%= link_to "本一覧に戻る",
              books_path,
              class: "secondary-button" %>

  <%= link_to "この本を削除する",
              book_path(@book),
              data: {
                turbo_method: :delete,
                turbo_confirm: "「#{@book.title}」を削除してもよろしいですか？"
              },
              class: "danger-button" %>

</div>